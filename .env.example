# Copy to .env.local and fill in. Never commit .env.local.
JIRA_BASE_URL=
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Only for *scoped* API tokens: set the site's cloud ID (from https://<site>.atlassian.net/_edge/tenant_info)
# JIRA_CLOUD_ID=

# Postgres for teams, members and saved views. Without it, teams are kept in the browser.
# URL-encode special characters in the password (# → %23).
DATABASE_URL=
