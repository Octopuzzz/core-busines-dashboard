# Supply-chain hardening (see SECURITY.md).

# Only install versions published at least 7 days ago. Malicious releases are usually
# detected and pulled within hours/days, so this keeps freshly-hijacked versions out.
min-release-age=7

# Install scripts (postinstall etc.) only run for packages approved in package.json "allowScripts".
# Anything new and unreviewed fails the install instead of running silently.
strict-allow-scripts=true

# Pin exact versions when adding dependencies (no surprise upgrades via ^ ranges).
save-exact=true

# Fail `npm audit` (and CI) on high/critical findings.
audit-level=high

# Refuse to install on a Node version the project doesn't support.
engine-strict=true

fund=false
